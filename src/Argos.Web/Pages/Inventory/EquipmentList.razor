@page "/inventory/equipment"

@attribute [Authorize(Policy = Permissions.InventoryView)]
@inject EquipmentClient Equipment
@inject InventoryReferenceClient Reference
@inject NavigationManager Navigation
@inject DisplayTime DisplayTime
@using SortDirection = Argos.Contracts.Common.SortDirection

@*
    Lista de equipamentos (US-03, RF-010; plan 15.15). Pesquisa, filtros, página e ordenação ficam na URL, a única fonte
    do estado: cada mudança navega para a nova URL e a lista é recarregada da API, que filtra, ordena e pagina.
*@
<PageTitle>Equipamentos · ARGOS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3" Wrap="Wrap.Wrap">
        <MudText Typo="Typo.h4" HtmlTag="h1">Equipamentos</MudText>
        <AuthorizeView Policy="@Permissions.InventoryManage">
            <MudButton Href="inventory/equipment/new" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add">
                Novo equipamento
            </MudButton>
        </AuthorizeView>
    </MudStack>

    <MudPaper Outlined="true" Class="pa-3 mb-3">
        <MudTextField T="string"
                      Value="Search"
                      ValueChanged="SearchChangedAsync"
                      DebounceInterval="400"
                      Immediate="true"
                      Label="Pesquisar"
                      Placeholder="Número de série, marca, modelo, rua, referência ou bairro"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Class="mb-3" />
        <div class="argos-filters">
            <MudSelect T="Guid" MultiSelection="true" Label="Tipo" Variant="Variant.Outlined" Dense="true"
                       SelectedValues="Selected(TypeId)" SelectedValuesChanged="values => FilterAsync(TypeKey, values)"
                       ToStringFunc="@(id => _types.FirstOrDefault(type => type.Id == id)?.Name ?? string.Empty)">
                @foreach (var type in _types)
                {
                    <MudSelectItem T="Guid" Value="@type.Id">@type.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="EquipmentStatus" MultiSelection="true" Label="Situação" Variant="Variant.Outlined" Dense="true"
                       SelectedValues="Parsed<EquipmentStatus>(Status)" SelectedValuesChanged="values => FilterAsync(StatusKey, values)"
                       ToStringFunc="@(status => InventoryLabels.For(status))">
                @foreach (var (status, _) in StatusTokens.All)
                {
                    <MudSelectItem T="EquipmentStatus" Value="@status">@InventoryLabels.For(status)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="MaintenanceNeed" MultiSelection="true" Label="Necessidade de manutenção" Variant="Variant.Outlined"
                       Dense="true" SelectedValues="Parsed<MaintenanceNeed>(MaintenanceNeed)"
                       SelectedValuesChanged="values => FilterAsync(NeedKey, values)"
                       ToStringFunc="@(need => InventoryLabels.For(need))">
                @foreach (var (need, _) in MaintenanceNeedTokens.All)
                {
                    <MudSelectItem T="MaintenanceNeed" Value="@need">@InventoryLabels.For(need)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Guid" MultiSelection="true" Label="Órgão" Variant="Variant.Outlined" Dense="true"
                       SelectedValues="Selected(OrganizationId)" SelectedValuesChanged="values => FilterAsync(OrganizationKey, values)"
                       ToStringFunc="@(id => _organizations.FirstOrDefault(organization => organization.Id == id)?.Acronym ?? string.Empty)">
                @foreach (var organization in _organizations)
                {
                    <MudSelectItem T="Guid" Value="@organization.Id">@organization.Acronym · @organization.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Guid" MultiSelection="true" Label="Região" Variant="Variant.Outlined" Dense="true"
                       SelectedValues="Selected(RegionId)" SelectedValuesChanged="values => FilterAsync(RegionKey, values)"
                       ToStringFunc="@(id => _regions.FirstOrDefault(region => region.Id == id)?.Name ?? string.Empty)">
                @foreach (var region in _regions)
                {
                    <MudSelectItem T="Guid" Value="@region.Id">@region.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Guid" MultiSelection="true" Label="Bairro" Variant="Variant.Outlined" Dense="true"
                       SelectedValues="Selected(NeighborhoodId)" SelectedValuesChanged="values => FilterAsync(NeighborhoodKey, values)"
                       ToStringFunc="@(id => _neighborhoods.FirstOrDefault(neighborhood => neighborhood.Id == id)?.Name ?? string.Empty)">
                @foreach (var neighborhood in _neighborhoods)
                {
                    <MudSelectItem T="Guid" Value="@neighborhood.Id">@neighborhood.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="EquipmentCategory" MultiSelection="true" Label="Fixo ou móvel" Variant="Variant.Outlined" Dense="true"
                       SelectedValues="Parsed<EquipmentCategory>(Category)" SelectedValuesChanged="values => FilterAsync(CategoryKey, values)"
                       ToStringFunc="@(category => InventoryLabels.For(category))">
                @foreach (var category in Enum.GetValues<EquipmentCategory>())
                {
                    <MudSelectItem T="EquipmentCategory" Value="@category">@InventoryLabels.For(category)</MudSelectItem>
                }
            </MudSelect>
        </div>
    </MudPaper>

    <ActiveFiltersBar Filters="ActiveFilters" OnRemove="RemoveFilterAsync" OnClear="ClearFiltersAsync" />
    <InventoryLegend />

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" role="alert" Class="mb-3">
            @_error
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="LoadAsync" Class="ml-2">
                Tentar novamente
            </MudButton>
        </MudAlert>
    }
    else if (_result is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-hidden="true" />
        <MudText Typo="Typo.body2" Class="mt-2" role="status">Carregando equipamentos…</MudText>
    }
    else if (_result.TotalCount == 0)
    {
        @if (ActiveFilters.Count > 0)
        {
            <EmptyState Title="Nenhum equipamento encontrado"
                        Description="Nenhum equipamento atende a todos os filtros aplicados. Remova algum filtro ou limpe todos.">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FilterAltOff"
                           OnClick="ClearFiltersAsync">
                    Limpar filtros
                </MudButton>
            </EmptyState>
        }
        else
        {
            <EmptyState Title="Nenhum equipamento cadastrado" Icon="@Icons.Material.Outlined.Inventory2" />
        }
    }
    else
    {
        <MudTable Items="_result.Items" Hover="true" Dense="true" Outlined="true" Loading="_loading"
                  Breakpoint="Breakpoint.Sm" T="EquipmentSummary">
            <HeaderContent>
                <MudTh>@SortHeader("Tipo", EquipmentSortFields.Type)</MudTh>
                <MudTh>@SortHeader("Número de série", EquipmentSortFields.SerialNumber)</MudTh>
                <MudTh>Marca e modelo</MudTh>
                <MudTh>@SortHeader("Situação", EquipmentSortFields.Status)</MudTh>
                <MudTh>Manutenção</MudTh>
                <MudTh>Órgão</MudTh>
                <MudTh>@SortHeader("Bairro", EquipmentSortFields.Neighborhood)</MudTh>
                <MudTh>@SortHeader("Atualizado em", EquipmentSortFields.UpdatedAt)</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Tipo"><EquipmentTypeIcon IconKey="@context.TypeIcon" Name="@context.TypeName" /></MudTd>
                <MudTd DataLabel="Número de série">
                    <MudLink Href="@($"inventory/equipment/{context.Id}")">@context.SerialNumber</MudLink>
                </MudTd>
                <MudTd DataLabel="Marca e modelo">@context.Brand @context.Model</MudTd>
                <MudTd DataLabel="Situação"><StatusBadge Status="context.Status" /></MudTd>
                <MudTd DataLabel="Manutenção"><MaintenanceNeedBadge Need="context.MaintenanceNeed" /></MudTd>
                <MudTd DataLabel="Órgão">@context.OrganizationAcronym</MudTd>
                <MudTd DataLabel="Bairro">@context.NeighborhoodName <MudText Typo="Typo.caption" Inline="true">(@context.RegionName)</MudText></MudTd>
                <MudTd DataLabel="Atualizado em">@DisplayTime.FormatDateTime(context.UpdatedAt)</MudTd>
            </RowTemplate>
        </MudTable>

        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mt-3" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.body2" role="status">
                @_result.TotalCount equipamento(s) · página @_result.Page de @PageCount
            </MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudSelect T="int" Value="CurrentPageSize" ValueChanged="PageSizeChangedAsync" Label="Por página"
                           Variant="Variant.Outlined" Dense="true" Style="width: 7rem">
                    @foreach (var size in PageSizes)
                    {
                        <MudSelectItem T="int" Value="size">@size</MudSelectItem>
                    }
                </MudSelect>
                <MudPagination Count="PageCount" Selected="_result.Page" SelectedChanged="PageChangedAsync"
                               Color="Color.Primary" ShowFirstButton="true" ShowLastButton="true" />
            </MudStack>
        </MudStack>
    }
</MudContainer>

@code {
    private const string SearchKey = "search";
    private const string TypeKey = "typeId";
    private const string StatusKey = "status";
    private const string OrganizationKey = "organizationId";
    private const string RegionKey = "regionId";
    private const string NeighborhoodKey = "neighborhoodId";
    private const string NeedKey = "maintenanceNeed";
    private const string CategoryKey = "category";
    private const string PageKey = "page";
    private const string PageSizeKey = "pageSize";
    private const string SortKey = "sort";
    private const string DirectionKey = "direction";

    private static readonly int[] PageSizes = [10, 25, 50, 100];

    private IReadOnlyList<EquipmentTypeData> _types = [];
    private IReadOnlyList<OrganizationData> _organizations = [];
    private IReadOnlyList<RegionData> _regions = [];
    private IReadOnlyList<NeighborhoodData> _neighborhoods = [];
    private PagedResult<EquipmentSummary>? _result;
    private string? _error;
    private bool _loading;
    private string? _loadedUri;

    [SupplyParameterFromQuery(Name = SearchKey)] public string? Search { get; set; }
    [SupplyParameterFromQuery(Name = TypeKey)] public Guid[]? TypeId { get; set; }
    [SupplyParameterFromQuery(Name = StatusKey)] public string[]? Status { get; set; }
    [SupplyParameterFromQuery(Name = OrganizationKey)] public Guid[]? OrganizationId { get; set; }
    [SupplyParameterFromQuery(Name = RegionKey)] public Guid[]? RegionId { get; set; }
    [SupplyParameterFromQuery(Name = NeighborhoodKey)] public Guid[]? NeighborhoodId { get; set; }
    [SupplyParameterFromQuery(Name = NeedKey)] public string[]? MaintenanceNeed { get; set; }
    [SupplyParameterFromQuery(Name = CategoryKey)] public string[]? Category { get; set; }
    [SupplyParameterFromQuery(Name = PageKey)] public int? Page { get; set; }
    [SupplyParameterFromQuery(Name = PageSizeKey)] public int? PageSize { get; set; }
    [SupplyParameterFromQuery(Name = SortKey)] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = DirectionKey)] public string? Direction { get; set; }

    private int CurrentPageSize => PageSize is { } size && PageSizes.Contains(size) ? size : PageQuery.DefaultPageSize;

    private string CurrentSort => Sort is { } sort && EquipmentSortFields.All.Contains(sort) ? sort : EquipmentSortFields.Default;

    private SortDirection CurrentDirection =>
        Enum.TryParse<SortDirection>(Direction, ignoreCase: true, out var direction) ? direction : SortDirection.Asc;

    private int PageCount => _result is null ? 1 : Math.Max(1, (int)Math.Ceiling(_result.TotalCount / (double)_result.PageSize));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var types = Reference.ListEquipmentTypesAsync();
            var organizations = Reference.ListOrganizationsAsync();
            var regions = Reference.ListRegionsAsync();
            var neighborhoods = Reference.ListNeighborhoodsAsync();
            (_types, _organizations, _regions, _neighborhoods) = (await types, await organizations, await regions, await neighborhoods);
        }
        catch (Exception exception) when (exception is ApiProblemException or HttpRequestException)
        {
            _error = "Não foi possível carregar as listas dos filtros. Tente novamente.";
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // A URL mudou (filtro, página, ordenação, voltar do navegador): recarrega uma vez por URL.
        if (Navigation.Uri != _loadedUri)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loadedUri = Navigation.Uri;
        _loading = true;
        _error = null;

        try
        {
            _result = await Equipment.SearchAsync(new EquipmentSearchQuery
            {
                Search = Search,
                TypeId = [.. TypeId ?? []],
                Status = [.. Parsed<EquipmentStatus>(Status)],
                OrganizationId = [.. OrganizationId ?? []],
                RegionId = [.. RegionId ?? []],
                NeighborhoodId = [.. NeighborhoodId ?? []],
                MaintenanceNeed = [.. Parsed<MaintenanceNeed>(MaintenanceNeed)],
                Category = [.. Parsed<EquipmentCategory>(Category)],
                Page = Math.Max(1, Page ?? 1),
                PageSize = CurrentPageSize,
                Sort = CurrentSort,
                Direction = CurrentDirection,
            });
        }
        catch (ApiProblemException problem)
        {
            _error = problem.IsValidation
                ? "Os filtros da URL são inválidos. Limpe os filtros e tente de novo."
                : problem.Message;
        }
        catch (HttpRequestException)
        {
            _error = "Não foi possível falar com o servidor. Verifique a conexão e tente novamente.";
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyList<ActiveFilter> ActiveFilters
    {
        get
        {
            var filters = new List<ActiveFilter>();
            if (!string.IsNullOrWhiteSpace(Search))
            {
                filters.Add(new ActiveFilter(SearchKey, Search, $"Pesquisa: {Search}"));
            }

            Add(TypeKey, TypeId, id => $"Tipo: {_types.FirstOrDefault(type => type.Id == id)?.Name ?? "…"}");
            Add(StatusKey, Parsed<EquipmentStatus>(Status), status => $"Situação: {InventoryLabels.For(status)}");
            Add(NeedKey, Parsed<MaintenanceNeed>(MaintenanceNeed), need => $"Manutenção: {InventoryLabels.For(need)}");
            Add(OrganizationKey, OrganizationId,
                id => $"Órgão: {_organizations.FirstOrDefault(organization => organization.Id == id)?.Acronym ?? "…"}");
            Add(RegionKey, RegionId, id => $"Região: {_regions.FirstOrDefault(region => region.Id == id)?.Name ?? "…"}");
            Add(NeighborhoodKey, NeighborhoodId,
                id => $"Bairro: {_neighborhoods.FirstOrDefault(neighborhood => neighborhood.Id == id)?.Name ?? "…"}");
            Add(CategoryKey, Parsed<EquipmentCategory>(Category), category => InventoryLabels.For(category));
            return filters;

            void Add<T>(string key, IEnumerable<T>? values, Func<T, string> label)
            {
                foreach (var value in values ?? [])
                {
                    filters.Add(new ActiveFilter(key, value!.ToString()!, label(value)));
                }
            }
        }
    }

    private RenderFragment SortHeader(string label, string field) => __builder =>
    {
        var active = CurrentSort == field;
        var icon = !active
            ? Icons.Material.Filled.UnfoldMore
            : CurrentDirection == SortDirection.Asc ? Icons.Material.Filled.ArrowUpward : Icons.Material.Filled.ArrowDownward;
        <MudButton Variant="Variant.Text" Size="Size.Small" EndIcon="@icon" OnClick="() => SortAsync(field)" Class="argos-sort"
                   aria-label="@($"Ordenar por {label.ToLowerInvariant()}")"
                   aria-sort="@(active ? (CurrentDirection == SortDirection.Asc ? "ascending" : "descending") : "none")">
            @label
        </MudButton>
    };

    private static IReadOnlyCollection<Guid> Selected(Guid[]? values) => values ?? [];

    private static IReadOnlyCollection<T> Parsed<T>(string[]? values)
        where T : struct, Enum =>
        (values ?? []).Select(value => Enum.TryParse<T>(value, ignoreCase: true, out var parsed) ? (T?)parsed : null)
            .OfType<T>()
            .ToArray();

    private Task SearchChangedAsync(string? search) =>
        NavigateAsync(new Dictionary<string, object?> { [SearchKey] = string.IsNullOrWhiteSpace(search) ? null : search.Trim() });

    private Task FilterAsync<T>(string key, IEnumerable<T>? values) =>
        NavigateAsync(new Dictionary<string, object?>
        {
            [key] = values?.Select(value => value!.ToString()).ToArray() is { Length: > 0 } array ? array : null,
        });

    private Task RemoveFilterAsync(ActiveFilter filter)
    {
        if (filter.Key == SearchKey)
        {
            return SearchChangedAsync(null);
        }

        var remaining = new Uri(Navigation.Uri).Query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(pair => pair.Split('=', 2))
            .Where(pair => Uri.UnescapeDataString(pair[0]) == filter.Key)
            .Select(pair => Uri.UnescapeDataString(pair.ElementAtOrDefault(1) ?? string.Empty))
            .Where(value => !string.Equals(value, filter.Value, StringComparison.OrdinalIgnoreCase))
            .ToArray();

        return NavigateAsync(new Dictionary<string, object?> { [filter.Key] = remaining.Length > 0 ? remaining : null });
    }

    private Task ClearFiltersAsync() =>
        NavigateAsync(new Dictionary<string, object?>
        {
            [SearchKey] = null, [TypeKey] = null, [StatusKey] = null, [OrganizationKey] = null, [RegionKey] = null,
            [NeighborhoodKey] = null, [NeedKey] = null, [CategoryKey] = null,
        });

    private Task SortAsync(string field)
    {
        var direction = CurrentSort == field && CurrentDirection == SortDirection.Asc ? SortDirection.Desc : SortDirection.Asc;
        return NavigateAsync(
            new Dictionary<string, object?> { [SortKey] = field, [DirectionKey] = direction.ToString().ToLowerInvariant() },
            resetPage: false);
    }

    private Task PageChangedAsync(int page) =>
        NavigateAsync(new Dictionary<string, object?> { [PageKey] = page }, resetPage: false);

    private Task PageSizeChangedAsync(int size) =>
        NavigateAsync(new Dictionary<string, object?> { [PageSizeKey] = size });

    /// <summary>Aplica a mudança à URL; mudar filtros volta para a primeira página.</summary>
    private Task NavigateAsync(Dictionary<string, object?> changes, bool resetPage = true)
    {
        if (resetPage)
        {
            changes[PageKey] = null;
        }

        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(changes));
        return Task.CompletedTask;
    }
}
