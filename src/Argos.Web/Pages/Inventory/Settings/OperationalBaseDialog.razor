@inject InventoryReferenceClient Reference

@* Criar ou editar base operacional (RF-019; D-57): nome único no órgão, órgão e localização completa. *@
<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@(Existing is null ? "Nova base" : "Editar base")</MudText></TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_request.Name" Label="Nome" Variant="Variant.Outlined" Required="true" MaxLength="80"
                                  Error="@_errors.Has("name")" ErrorText="@_errors.For("name")" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid?" @bind-Value="_request.OrganizationId" Label="Órgão" Variant="Variant.Outlined" Required="true"
                               Error="@_errors.Has("organizationId")" ErrorText="@_errors.For("organizationId")">
                        @foreach (var organization in Organizations)
                        {
                            <MudSelectItem T="Guid?" Value="@organization.Id">@organization.Acronym · @organization.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            <LocationFields Value="_request.Location!" Errors="_errors" Municipality="Municipality" Neighborhoods="Neighborhoods" />
            <SaveErrorAlert Message="@_error" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="_saving">
            @(_saving ? "Salvando…" : "Salvar")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly FieldErrors _errors = new();
    private OperationalBaseRequest _request = new() { Location = new LocationInput() };
    private string? _error;
    private bool _saving;

    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = null!;

    [Parameter]
    public OperationalBaseData? Existing { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<OrganizationData> Organizations { get; set; } = [];

    [Parameter, EditorRequired]
    public IReadOnlyList<NeighborhoodData> Neighborhoods { get; set; } = [];

    [Parameter]
    public MunicipalityData? Municipality { get; set; }

    protected override void OnInitialized()
    {
        if (Existing is not null)
        {
            var location = Existing.Location;
            _request = new OperationalBaseRequest
            {
                Name = Existing.Name,
                OrganizationId = Existing.OrganizationId,
                Location = new LocationInput
                {
                    ZipCode = location.ZipCode,
                    Street = location.Street,
                    NeighborhoodId = location.NeighborhoodId,
                    Reference = location.Reference,
                    Latitude = location.Latitude,
                    Longitude = location.Longitude,
                },
            };
        }
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        (_error, var saved) = await SaveForm.RunAsync(_errors, ["name", "organizationId", "location"], () => Existing is null
            ? Reference.CreateOperationalBaseAsync(_request)
            : Reference.UpdateOperationalBaseAsync(Existing.Id, _request));
        _saving = false;

        if (saved is not null)
        {
            Dialog.Close(DialogResult.Ok(saved));
        }
    }
}
