@using Argos.Web.Interop
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject MapOptions Options

@* Mapa base próprio, só com as ruas e sem rótulos, recolorido junto com o tema (Art. X.4; D-08). *@
<div @ref="_element" class="argos-map" role="region" aria-label="Mapa da cidade"></div>

@code {
    private ElementReference _element;
    private LeafletMapInterop? _interop;
    private DotNetObjectReference<ArgosMap>? _self;
    private bool _renderedDarkMode;
    private IReadOnlyList<MapMarker>? _drawnMarkers;
    private IReadOnlyList<MapRegion>? _drawnRegions;

    [CascadingParameter(Name = "IsDarkMode")]
    public bool IsDarkMode { get; set; } = true;

    /// <summary>Marcadores a desenhar (Central). Uma lista nova substitui a anterior.</summary>
    [Parameter]
    public IReadOnlyList<MapMarker>? Markers { get; set; }

    /// <summary>Chave do marcador clicado.</summary>
    [Parameter]
    public EventCallback<string> OnMarkerClick { get; set; }

    /// <summary>Regiões a pintar (Preditiva). Uma lista nova substitui a anterior.</summary>
    [Parameter]
    public IReadOnlyList<MapRegion>? Regions { get; set; }

    /// <summary>Chave da região clicada.</summary>
    [Parameter]
    public EventCallback<string> OnRegionClick { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _interop = new LeafletMapInterop(JSRuntime);
            _self = DotNetObjectReference.Create(this);
            await _interop.CreateAsync(_element, Options.CenterLatitude, Options.CenterLongitude, Options.Zoom, IsDarkMode);
            _renderedDarkMode = IsDarkMode;
        }
        else if (_interop is not null && _renderedDarkMode != IsDarkMode)
        {
            await _interop.SetDarkModeAsync(IsDarkMode);
            _renderedDarkMode = IsDarkMode;
        }

        if (_interop is not null && _self is not null && Markers is not null && !ReferenceEquals(Markers, _drawnMarkers))
        {
            _drawnMarkers = Markers;
            await _interop.SetMarkersAsync(Markers, _self);
        }

        if (_interop is not null && _self is not null && Regions is not null && !ReferenceEquals(Regions, _drawnRegions))
        {
            _drawnRegions = Regions;
            await _interop.SetRegionsAsync(Regions, _self);
        }
    }

    /// <summary>Move marcadores já desenhados, sem recarregar a tela (tempo real; RF-028).</summary>
    public async Task UpdatePositionsAsync(IReadOnlyList<MapPositionUpdate> updates)
    {
        if (_interop is not null)
        {
            await _interop.UpdatePositionsAsync(updates);
        }
    }

    /// <summary>Centraliza e aproxima o mapa (RF-037); com a chave, abre o grupo que esconde o marcador.</summary>
    public async Task FocusOnAsync(double latitude, double longitude, string? key = null, int zoom = 16)
    {
        if (_interop is not null)
        {
            await _interop.FocusOnAsync(latitude, longitude, zoom, key);
        }
    }

    [JSInvokable]
    public Task OnMarkerClicked(string key) => OnMarkerClick.InvokeAsync(key);

    [JSInvokable]
    public Task OnRegionClicked(string key) => OnRegionClick.InvokeAsync(key);

    public async ValueTask DisposeAsync()
    {
        if (_interop is not null)
        {
            await _interop.DisposeAsync();
        }

        _self?.Dispose();
    }
}
