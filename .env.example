# Modelo das variáveis do ambiente do ARGOS (Art. III.9; plan 6.4, 7.2).
# Copie para .env (que não é versionado) e ajuste se quiser: cp .env.example .env
# Todos os valores abaixo são fictícios e servem só para a demonstração local.

# Banco PostgreSQL
POSTGRES_DB=argos
POSTGRES_USER=argos
POSTGRES_PASSWORD=troque-esta-senha-local

# Porta do banco no host (só em 127.0.0.1). Troque se a 5432 já estiver em uso na sua máquina.
POSTGRES_HOST_PORT=5432

# Semente da simulação: a mesma semente gera os mesmos dados (Art. IX.3).
SIMULATION_SEED=42

# Intervalo, em segundos, do sinal de vida técnico do simulador (Fase 0).
HEARTBEAT_INTERVAL_SECONDS=5

# Acesso (plan 14.13). Segredos: troque os valores antes de mostrar o ambiente a alguém.
# Chave de assinatura do token de acesso dos usuários (JWT). No mínimo 32 caracteres.
ARGOS_JWT_SIGNING_KEY=troque-esta-chave-de-assinatura-do-jwt-local
# Chave de sistema com que o Simulador (PROMETHEUS) se autentica na API. No mínimo 32 caracteres.
ARGOS_SYSTEM_KEY=troque-esta-chave-de-sistema-do-simulador

# Usuários de demonstração, um por perfil (RF-053). Fictícios; aparecem na tela de login para preenchimento rápido.
# Login: 3 a 50 caracteres entre a-z, 0-9, ponto, hífen e sublinhado.
# Senha: 8 a 64 caracteres entre letras sem acento, números, ponto, hífen e sublinhado.
DEMO_ADMIN_LOGIN=admin
DEMO_ADMIN_PASSWORD=troque-senha-admin
DEMO_OPERATOR_LOGIN=operador
DEMO_OPERATOR_PASSWORD=troque-senha-operador
DEMO_MANAGER_LOGIN=gestor
DEMO_MANAGER_PASSWORD=troque-senha-gestor
