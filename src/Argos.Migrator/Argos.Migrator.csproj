<Project Sdk="Microsoft.NET.Sdk">

  <!-- Execução única: aplica as migrations, registra o seed, carrega o Inventário e reconcilia os usuários de demonstração
       (plan 5.3, 7.4, 14.10, 15.11.4). Infrastructure só para DI e migração. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Usuários de demonstração locais por user-secrets em Development (D-45). -->
    <UserSecretsId>argos-migrator</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Argos.Application\Argos.Application.csproj" />
    <ProjectReference Include="..\Argos.Infrastructure\Argos.Infrastructure.csproj" />
    <ProjectReference Include="..\Argos.Simulation\Argos.Simulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
